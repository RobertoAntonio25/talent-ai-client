# Copia a .env

# Backend (REQUERIDO): URL base de la API del entorno que uses (dev).
# Sin esta variable la app no arranca. Pide el valor al equipo; nunca lo commitees.
VIT_API_URL=
# Alias estandar Vite (opcional si ya usas VIT_):
# VITE_API_URL=

# Supabase Auth - solo OAuth login (nunca la service_role).
VIT_SUPABASE_URL=
VIT_SUPABASE_ANON_KEY=
# Alias estandar (opcionales):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=